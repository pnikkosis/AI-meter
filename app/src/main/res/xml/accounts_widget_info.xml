<?xml version="1.0" encoding="utf-8"?>
<!-- Several accounts at once. Works without its dialog: it lists every account visible on Home. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.kmnexus.codexmeter.widget.AccountsWidgetConfigurationActivity"
    android:description="@string/accounts_widget_description"
    android:initialLayout="@layout/codexmeter_widget_loading"
    android:previewLayout="@layout/widget_preview_accounts"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="60dp"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="420dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:widgetCategory="home_screen" />
