<?xml version="1.0" encoding="utf-8"?>
<!--
  No cleartext traffic and no custom trust anchors: every request is HTTPS validated against the
  system CAs. The Claude sign-in loopback redirect (http://localhost:{port}/callback) is served BY
  the app to the browser, so it needs no cleartext exemption here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
