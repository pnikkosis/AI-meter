    <string name="account_delete_dialog_message_codex">The app deletes the sign-in tokens, usage history and widget data of %1$s from this device and asks OpenAI to revoke the sign-in. If the revocation fails, the local data is deleted anyway.</string>
    <string name="account_delete_dialog_message_claude">The app deletes the sign-in tokens, usage history and widget data of %1$s from this device. Anthropic offers no way for apps to revoke this sign-in remotely. Your browser\'s claude.ai session is not affected.</string>
