    <string name="claude_login_title">Connect Claude</string>
    <string name="claude_login_relogin_title">Sign in to Claude again</string>
    <string name="claude_login_disclosure_title">Before you continue</string>
    <string name="claude_login_disclosure_browser">Sign-in happens on claude.ai in your browser. This app never sees your password or your browser cookies; it only receives a one-time authorization code on this device.</string>
    <string name="claude_login_disclosure_client">The authorization page will name Claude Code: Anthropic offers no public sign-in for other apps, so this app uses the public sign-in client of Anthropic\'s Claude Code CLI.</string>
    <string name="claude_login_disclosure_scope">Permission requested: user:profile. The app uses it only to read your profile and usage limits. It does not request user:inference (sending messages with your plan) or org:create_api_key (creating API keys). Anthropic does not document everything user:profile allows, so do not treat the token as read-only: it is a credential for your Claude account.</string>
    <string name="claude_login_disclosure_storage">The tokens stay on this device, encrypted with an Android Keystore key. Disconnecting deletes them from the device; Anthropic provides no way for this app to revoke the authorization on its servers.</string>
    <string name="claude_login_disclosure_policy">Anthropic\'s terms reserve this sign-in for Claude Code and Anthropic\'s own apps, and Anthropic may restrict accounts that use it elsewhere. Continue only if you accept that risk. Without signing in, you can check usage in the official Claude app or on claude.ai under Settings &gt; Usage.</string>
